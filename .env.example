# Data (docker-compose mounts ./data at /app/data; these defaults work for local runs from the repo root)
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Today's date as YYYY-MM-DD. Leave empty to use the system date.
APP_TODAY=

# LLM
# Provider: anthropic | openai | groq. Only the selected provider's key is needed.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Leave empty for api.openai.com; set it to use another OpenAI-compatible server.
OPENAI_BASE_URL=
# Groq (https://console.groq.com/keys) serves an OpenAI-compatible API.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Anthropic only. Reasoning effort: low | medium | high (low keeps answers well inside the 30 s limit)
LLM_EFFORT=low
# Anthropic only. "default" enables server-side refusal fallbacks; "off" disables them (e.g. for models that don't support them)
LLM_FALLBACKS=default
LLM_TIMEOUT_S=20
REQUEST_DEADLINE_S=27

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=./.cache/models

# Logging (JSON lines; never contains names, emails or phone numbers)
LOG_LEVEL=INFO
LOG_FILE=
